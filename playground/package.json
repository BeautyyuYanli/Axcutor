{
  "name": "axcutor-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "generate:openapi": "uv run --project .. --locked python -m axcutor_host.http --output openapi.json",
    "generate:client": "npm run generate:openapi && openapi-ts",
    "generate:wasm": "python3 scripts/build_wasm.py",
    "generate": "npm run generate:client && npm run generate:wasm",
    "test:browser": "node scripts/browser_smoke.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@vue-flow/core": "1.48.2",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.1.4"
  }
}
